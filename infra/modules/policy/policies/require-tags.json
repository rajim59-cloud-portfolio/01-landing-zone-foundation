{
  "if": {
    "allOf": [
      {
        "field": "type",
        "notEquals": "Microsoft.Resources/subscriptions/resourceGroups"
      },
      {
        "anyOf": [
          { "field": "tags['CostCenter']", "exists": "false" },
          { "field": "tags['Env']", "exists": "false" },
          { "field": "tags['Owner']", "exists": "false" }
        ]
      }
    ]
  },
  "then": {
    "effect": "deny"
  }
}